# Local development — copy to .env and fill in values. Never commit .env.

# API
PORT=3000
NODE_ENV=development

# Database (PostgreSQL local)
# Create the database first, for example:
#   createdb truck_parts_dev
# or via psql:
#   CREATE DATABASE truck_parts_dev;
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/truck_parts_dev

# Integration tests (separate database recommended)
# Create with: createdb truck_parts_test
# DATABASE_URL_TEST=postgresql://postgres:YOUR_PASSWORD@localhost:5432/truck_parts_test


DATABASE_USER= postgres
DATABASE_PASSWORD= YOUR_PASSWORD
DATABASE_NAME= truck_parts_dev
DATABASE_PORT= 5432




# Sessions (Milestone 6+)
# SESSION_SECRET=

